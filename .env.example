# Quip dashboard — environment variables
#
# Copy to `.env` and uncomment what you need to override. Values shown here are
# the built-in defaults or example local/test values. No value in this file is
# a live secret or credential. Keep your own `.env` out of version control; it
# is ignored by git.

# ── Database ───────────────────────────────────────────────────────────────
#
# Storage backend selection. Leave DATABASE_URL empty to use the embedded Turso
# database (the default). Set it to a valid Postgres URL to use Postgres. Any
# other value fails startup; an invalid URL never falls back to local storage.
# The example URL below is a local test value only, not a real service.
#
# Empty (default) → embedded Turso at QUIP_EMBEDDED_DB_PATH
# postgresql://…  → Postgres server
#
#DATABASE_URL=

# Embedded Turso database file path. Default: /data/dashboard.db (container).
# Use an absolute path on the host for local development.
#QUIP_EMBEDDED_DB_PATH=/data/dashboard.db

# Reader pool size for the Postgres backend, at most 64. Default: 10.
#DATABASE_POOL_MAX=10

# ── Runtime mode ────────────────────────────────────────────────────────────
#
# Set false or 0 to run API-only mode (requires Postgres). Default: true.
RUN_INDEXER=true

# Internal HTTP port for the backend API and health routes. Default: 3001.
#PORT=3001

# ── Upstream endpoints ──────────────────────────────────────────────────────
#
# Example local endpoints for development. Point these at reachable services
# when you run a validator or miner on the host. The backend talks to these
# directly; it does not self-proxy.
#
# Comma-separated direct WebSocket validator endpoints. Default:
# ws://quip-validator:9944. For a local node: ws://127.0.0.1:9944
QUIP_VALIDATOR_RPC_URLS=ws://127.0.0.1:9944

# Independent miner HTTP endpoint. Default: http://quip-miner:8086. For a
# local miner: http://127.0.0.1:8086
QUIP_MINER_REST_URL=http://127.0.0.1:8086

# Local miner polling cadence in seconds, 8 through 60. Default: 8.
#POLL_INTERVAL_SEC=8

# ── Operator identity ───────────────────────────────────────────────────────
#
# Optional operator SS58 account (46 to 50 base58 characters). Used to identify
# the local miner in API projections. Example placeholder; set your own.
#QUIP_OPERATOR_ACCOUNT=

# ── Geo-IP enrichment ───────────────────────────────────────────────────────
#
# Optional local MaxMind GeoLite2-City database path. When missing or
# unreadable, location stays absent and the backend logs an operator warning.
# No external geolocation service is used.
#GEOIP_DB_PATH=

# ── Container supervisor (production image) ────────────────────────────────
#
# These are set by deploy/docker-compose.yml for the dev stack. The image
# applies them through entrypoint.sh and the syslog rotate script.
#
# Numeric user and group for the runtime services. Default: 1000.
#PUID=1000
#PGID=1000

# Caddy listen addresses and TLS. Example local value (HTTP only):
#QUIP_HOSTNAME=:20049
#QUIP_HOSTNAME=cpu-1.example.net, cpu-1.example.net:20049

# ACME account email for Let's Encrypt. Example placeholder.
#CERT_EMAIL=hostmaster@example.com

# Log rotation. Max bytes then number of kept archives, then check interval.
#QUIP_LOG_MAX_BYTES=10485760
#QUIP_LOG_KEEP=5
#QUIP_LOG_CHECK_INTERVAL=30

# Static frontend builds can use a separate Rust API origin.
#VITE_API_BASE_URL=https://dashboard-api.example.com
