# Quip dashboard — environment variables
#
# Copy to `.env` (auto-loaded by Bun and `netlify dev`) and uncomment what you
# need to override. Every value shown below is the built-in default, so an
# empty `.env` reproduces the default local-dev setup (SQLite + co-located
# validator). Most options also have an equivalent indexer CLI flag.

# ── Database (server + indexer + netlify function) ───────────────────────────

# Which adapter to use: "sqlite" or "postgres".
#DB_ADAPTER=sqlite

# Postgres connection string. REQUIRED when DB_ADAPTER=postgres; ignored for
# sqlite. Setting DATABASE_URL without DB_ADAPTER=postgres is a hard error
# (guards against a Postgres deploy silently falling back to a local file).
#DATABASE_URL=postgresql://quip:quip@localhost:5432/quip

# SQLite file path (sqlite adapter only). Code default is ./data/telemetry.db;
# the container image sets /data/telemetry.db. ":memory:" gives an ephemeral DB.
#SQLITE_PATH=./data/telemetry.db

# ── HTTP server (server/main.ts) ─────────────────────────────────────────────

# Port the Hono server listens on. (Container default is 3001.)
#PORT=3001

# Directory of the built SPA served as a fallback. Code default ./dist;
# container sets /app/dist.
#STATIC_DIR=./dist

# ── Indexer: validator (substrate) RPC ───────────────────────────────────────

# Comma-separated substrate RPC endpoints; the substrate/descriptor workers
# round-robin on failure and index 0 is the default for chain-derived identity.
# Default is the docker-compose service name — point this at a reachable node
# for local dev (e.g. ws://127.0.0.1:9944). CLI: --validator-rpc-urls
#QUIP_VALIDATOR_RPC_URLS=ws://quip-validator:9944

# Per-request timeout (ms) for the WsProvider handshake and RPC calls.
# CLI: --substrate-rpc-timeout
#QUIP_VALIDATOR_RPC_TIMEOUT_MS=15000

# Upper bound (ms) on the exponential reconnect backoff (±20% jitter).
# CLI: --substrate-reconnect-max-backoff
#QUIP_VALIDATOR_RECONNECT_MAX_BACKOFF_MS=60000

# Cadence (s) for re-polling BABE epoch state. CLI: --substrate-babe-poll
#QUIP_VALIDATOR_BABE_POLL_SEC=30

# Cadence (s) for re-polling chain surfaces (miners, difficulty, validators).
# More expensive: O(miners) RPCs. CLI: --substrate-chain-poll
#QUIP_VALIDATOR_CHAIN_POLL_SEC=6

# ── Indexer: node-descriptor / identity ──────────────────────────────────────

# Block height the descriptor worker scans from on a fresh DB ("1" = genesis).
# Set to a recent height on long-lived chains to skip an O(history) backfill.
# Resume-from-checkpoint takes over after the first pass. CLI: --descriptor-start-block
#QUIP_DESCRIPTOR_START_BLOCK=1

# Operator SS58 to seed self_address on first start, skipping the tip-worker
# identity probe. Optional; ignored once the DB has a cached self address.
# Must be a 46–50 char base58 substrate address. CLI: --operator-account
#QUIP_OPERATOR_ACCOUNT=

# ── Indexer: general ─────────────────────────────────────────────────────────

# Tip-worker probe cadence (s). CLI: --poll-interval
#POLL_INTERVAL_SEC=8

# Legacy nodes-refresh cadence (s); currently informational only. CLI: --nodes-refresh
#NODES_REFRESH_SEC=45

# Seconds without chain-tip advance before the indexer WARNs that the node
# looks stalled. 0 disables the check. CLI: --stall-warn-after
#STALL_WARN_AFTER_SEC=600

# Set to "1" to enable verbose debug logging. CLI: --verbose
#VERBOSE=

# ── Container entrypoint supervisor (docker/entrypoint.ts) ────────────────────

# Toggle which child processes the container starts. Set RUN_INDEXER=false on a
# chain-only host (e.g. Netlify Postgres), RUN_SERVER=false on a dedicated
# indexer host. "false" or "0" disables; anything else (or unset) enables.
#RUN_SERVER=true
#RUN_INDEXER=true

# ── Geo-IP enrichment (server) ───────────────────────────────────────────────

# Path to a MaxMind GeoLite2-City .mmdb. When set, node locations are resolved
# via that database; otherwise the bundled geoip-lite is used, and geo is
# disabled if neither is available.
#GEOIP_DB_PATH=

# ── Testing (optional) ───────────────────────────────────────────────────────

# Postgres URL for the adapter integration tests. Unset → those tests skip.
#TEST_POSTGRES_URL=postgresql://quip:quip@localhost:5432/quip_test

# Live substrate node for the substrate-client integration test. Unset → skip.
#QUIP_TEST_VALIDATOR_RPC_URL=ws://127.0.0.1:9944
