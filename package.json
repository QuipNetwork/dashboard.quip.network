{
  "name": "quip-dashboard",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:server": "bun run server/main.ts",
    "dev:indexer": "bun run indexer/main.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "bun run server/migrate.ts",
    "start": "bun run docker/entrypoint.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@nivo/bar": "^0.88.0",
    "@nivo/core": "^0.88.0",
    "@nivo/line": "^0.88.0",
    "@nivo/pie": "0.88.0",
    "@nivo/tooltip": "^0.88.0",
    "geoip-lite": "^2.0.1",
    "hono": "^4.12.14",
    "maxmind": "^5.0.6",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "^1.3.10",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsdom": "^28.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.0.0",
    "netlify-cli": "^24.3.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.4"
  }
}
