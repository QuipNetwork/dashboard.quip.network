{
  "name": "quip-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "netlify dev",
    "dev:server": "bun run --filter @quip/server dev",
    "dev:indexer": "bun run --filter @quip/indexer dev",
    "build": "tsc -b && vite build && bun run verify:no-polkadot-in-bundle",
    "verify:no-polkadot-in-bundle": "if grep -rq '@polkadot' dist/assets/ 2>/dev/null; then echo 'FAIL: @polkadot/* leaked into the SPA bundle. The substrate worker is indexer-only — never import @polkadot/* from src/.' >&2; exit 1; fi",
    "preview": "vite preview",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "bun run --filter @quip/server migrate",
    "start": "bun run docker/entrypoint.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns '**/reference-material/**'"
  },
  "dependencies": {
    "@quip/shared": "workspace:*",
    "@quip/core": "workspace:*",
    "@nivo/bar": "^0.88.0",
    "@nivo/core": "^0.88.0",
    "@nivo/line": "^0.88.0",
    "@nivo/pie": "0.88.0",
    "@nivo/tooltip": "^0.88.0",
    "@vaaas/rx-react": "0.3.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "^1.3.10",
    "@types/jsdom": "^28.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.0.0",
    "netlify-cli": "^24.3.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.4"
  }
}
