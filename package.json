{
  "name": "quip-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "netlify dev --filter @quip/frontend",
    "dev:server": "bun run --filter @quip/server dev",
    "dev:indexer": "bun run --filter @quip/indexer dev",
    "build": "bun run --filter @quip/frontend build && bun run verify:no-polkadot-in-bundle",
    "verify:no-polkadot-in-bundle": "if grep -rq '@polkadot' apps/frontend/dist/assets/ 2>/dev/null; then echo 'FAIL: @polkadot/* leaked into the SPA bundle. The substrate worker is indexer-only — never import @polkadot/* from the frontend.' >&2; exit 1; fi",
    "preview": "bun run --filter @quip/frontend preview",
    "ladle": "bun run --filter @quip/frontend ladle",
    "ladle:build": "bun run --filter @quip/frontend ladle:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "bun run --filter @quip/server migrate",
    "start": "bun run deploy/entrypoint.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit",
    "test": "bun test --path-ignore-patterns '**/reference-material/**'"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "netlify-cli": "^24.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3"
  }
}
