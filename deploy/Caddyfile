# Caddy front-door for the combined dashboard image.
#
# Ported from nodes.quip.network caddy/Caddyfile at
# e4de2d6215a066dc308bc9359b6f2f510ae7caa0
# sha256:0746f9420393b56acfa0f33b503ff10416bcc453b16df5944d68e9307918c759
# Dashboard-owned changes: static SPA at /app/frontend, dashboard API on
# 127.0.0.1:3001, env-parameterized upstreams, cache headers, private admin.
#
# QUIP_HOSTNAME controls listen addresses and TLS in a single value:
#
#   Dev / localhost (HTTP only):
#     QUIP_HOSTNAME=:20049
#   Bare port -> HTTP on that port, no auto-TLS.
#
#   Production (auto-TLS on :443 + :20049, :80 auto-redirects to :443):
#     QUIP_HOSTNAME=cpu-1.nodes.quip.network, cpu-1.nodes.quip.network:20049
#   Two comma-separated bare DNS entries: Caddy provisions one Let's Encrypt
#   cert covering both, auto-binds :443 + :20049, and adds the :80 redirect.
#   Port 80 must be reachable from the internet for the ACME HTTP-01 challenge.
#
# CERT_EMAIL registers the ACME account. Default issuer is Let's Encrypt with
# ZeroSSL as automatic fallback (Caddy 2.6+). The placeholder default keeps
# Caddy parseable in dev mode (no ACME runs without a real DNS name); set a
# real email in .env before exposing the site over TLS.
#
# Caddy state directories are process environment, not this file. The image
# and supervisor must set:
#   XDG_DATA_HOME=/data/caddy/data
#   XDG_CONFIG_HOME=/data/caddy/config
# so later nodes mounts of the existing caddy-data / caddy-config volumes
# keep certificates at the same relative paths inside those volumes.
#
# Upstream defaults match the node stack. Tests override them so Caddy never
# dials real validator, miner, faucet, or dashboard processes:
#   QUIP_VALIDATOR_UPSTREAM  quip-validator:9944
#   QUIP_MINER_UPSTREAM      quip-miner:8086
#   QUIP_FAUCET_UPSTREAM     quip-faucet:8087
#   QUIP_DASHBOARD_UPSTREAM  127.0.0.1:3001
#
# The dashboard backend talks to validator and miner URLs directly. It does
# not self-proxy through the :8088 site below.
{
	admin off
	email {$CERT_EMAIL:hostmaster@localhost}
	# cert_issuer zerossl {$ZEROSSL_API_KEY}

	# Caddy picks its log encoder from the output: console when stderr is a
	# terminal, JSON otherwise. Under compose it is never a terminal, so pin
	# console explicitly — these lines are read by humans in `docker compose
	# logs` and in the node manager's log pane, not by a log shipper.
	#
	# The filter wrapper drops the fields that make a single 502 span twenty
	# lines: the full request header map, the duplicate client address, and
	# Caddy's internal error id and stack trace. What survives is the part
	# that identifies the failure — method, host, URI, status, upstream error.
	log {
		format filter {
			wrap console {
				time_format wall_milli
				time_local
				level_format upper
			}
			request>headers delete
			request>remote_port delete
			request>client_ip delete
			request>proto delete
			err_trace delete
			err_id delete
		}
	}
}

(routing) {
	# Compress every response the client accepts gzip for. The JSON API and
	# the qblock files are repetitive text (SS58 addresses, field names).
	encode gzip

	# Substrate JSON-RPC (HTTP POST + WebSocket). Two handlers so both `/rpc`
	# and `/rpc/...` work — handle_path's `/rpc/*` pattern doesn't match a
	# bare `/rpc` (no trailing slash), which is the natural URL most clients
	# use.
	handle /rpc {
		header >Cache-Control "no-store"
		rewrite * /
		reverse_proxy {$QUIP_VALIDATOR_UPSTREAM:quip-validator:9944}
	}
	handle_path /rpc/* {
		header >Cache-Control "no-store"
		reverse_proxy {$QUIP_VALIDATOR_UPSTREAM:quip-validator:9944}
	}

	# Optional faucet sidecar (`--profile faucet`). The bot serves /request
	# and /health; handle_path strips /api/faucet so external POST
	# /api/faucet/request reaches the bot's POST /request.
	handle_path /api/faucet/* {
		header >Cache-Control "no-store"
		reverse_proxy {$QUIP_FAUCET_UPSTREAM:quip-faucet:8087}
	}

	# Miner telemetry / v1 REST. 8086 is the port the coordinator's
	# [dashboard].listen binds in data/config.toml. Keep the two in sync.
	handle /api/v1/* {
		header >Cache-Control "no-store"
		reverse_proxy {$QUIP_MINER_UPSTREAM:quip-miner:8086}
	}

	# Dashboard API (health, live, history, telemetry). Live and other API
	# responses are not cached.
	handle /api/* {
		header >Cache-Control "no-store"
		reverse_proxy {$QUIP_DASHBOARD_UPSTREAM:127.0.0.1:3001}
	}

	# Static time-series files written by the indexer. Only the two trees
	# FileWriter produces are public: /data also holds the index database,
	# Caddy's certificates and ACME keys, and collector state.
	@public_files path /files/qblocks/* /files/miners/* /files/nodes/*
	handle @public_files {
		uri strip_prefix /files
		root * /data
		header Cache-Control "public, max-age=300"
		file_server
	}
	# Everything else under /files is private. Answer 404 rather than fall
	# through to the SPA.
	handle /files/* {
		respond 404
	}

	# Vite content-hashed files. Missing assets stay 404 instead of SPA HTML.
	handle /assets/* {
		root * /app/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Other static files (fonts, source maps, images). Missing files stay 404.
	@static_files {
		path /fonts/*
		path *.js
		path *.css
		path *.map
		path *.woff
		path *.woff2
		path *.ttf
		path *.otf
		path *.png
		path *.jpg
		path *.jpeg
		path *.svg
		path *.ico
		path *.webp
		path *.json
		path *.txt
		path *.xml
		path *.webmanifest
	}
	handle @static_files {
		root * /app/frontend
		file_server
	}

	# SPA fallback for navigation routes only. Revalidate the HTML entry point.
	handle {
		root * /app/frontend
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

{$QUIP_HOSTNAME::20049} {
	import routing
}

# Stack-internal front door (plain HTTP). In-network clients can use the same
# routes without the public site's TLS cert. Keep :8088 out of the compose
# ports map so it is reachable on the bridge network only. The dashboard
# backend does not need this path: it dials validator and miner directly.
:8088 {
	import routing
}
